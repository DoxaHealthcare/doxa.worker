# Existing worker variables remain required.
PORT=4001

# Must point to the same Redis/Valkey database used by doxa.backend.
REDIS_URL=redis://127.0.0.1:6379

# Number of BullMQ jobs processed concurrently by this worker process.
WORKER_CONCURRENCY=5

# Discord onboarding channels
DISCORD_DOCTOR_ONBOARDING_CHANNEL_ID=
DISCORD_PHARMACY_ONBOARDING_CHANNEL_NAME=pharmacy-onboarding
DISCORD_PHARMACY_ONBOARDING_CHANNEL_ID=
