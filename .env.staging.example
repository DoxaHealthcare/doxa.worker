# Worker STAGING environment - targets the doxa-test Firebase project.
#
# Usage:
#   pnpm dev:staging     (nodemon, loads this file via DOTENV_CONFIG_PATH)
#   pnpm start:staging   (plain tsx)
#
# Fill in every <...> placeholder before starting. Never commit real
# secrets - this file is meant to live only on your machine (it is gitignored
# the same way .env is; verify `git check-ignore .env.staging`).

# --- Firebase Admin (doxa-test service account) ---
# Download from Firebase Console > Project settings > Service accounts
# for project doxa-test. These MUST be the doxa-test values, not prod.
FIREBASE_PROJECT_ID=doxa-test
FIREBASE_CLIENT_EMAIL=<doxa-test service account client_email>
FIREBASE_PRIVATE_KEY=<doxa-test service account private_key, \n escaped>
FIREBASE_CLIENT_ID=<doxa-test service account client_id>
FIREBASE_PRIVATE_KEY_ID=<doxa-test service account private_key_id>

# --- Environment marker ---
ENV=staging
PORT=4001

# --- Redis (job queue + leader lease) ---
# Use a separate Redis DB/instance from prod so staging jobs never mix.
REDIS_URL=<redis-url-for-staging>
WORKER_CONCURRENCY=1

# --- Discord ---
# IMPORTANT: use DIFFERENT Discord channels/webhook than production so
# staging alerts never land in the prod ops channels.
DISTOKEN=<staging discord bot token, or leave empty to disable discord>
DISCORD_LOGS_CHANNEL_ID=<staging logs channel id>
DISCORD_NEW_CONSULTATION_CHANNEL_ID=<staging channel id>
DISCORD_NEW_USER_CHANNEL_ID=<staging channel id>
DISCORD_DOCTOR_ONBOARDING_CHANNEL_ID=<staging channel id>
DISCORD_PHARMACY_ONBOARDING_CHANNEL_ID=<staging channel id>
DISCORD_PHARMACY_ONBOARDING_CHANNEL_NAME=<staging channel name>
DISCORD_CONTACT_US_CHANNEL_ID=<staging channel id>
DISCORD_WALLET_WITHDRAWAL_CHANNEL_ID=<staging channel id>
DISCORD_CONSULTATION_PAYMENT_CHANNEL_ID=<staging payout approval channel id>

# --- Email (Resend) ---
# Use a staging/sandbox sender domain if Resend provides one.
RESEND_API_KEY=<resend api key>
EMAIL_FROM=<staging sender, e.g. Doxa Staging <noreply@...>>
EMAIL_FROM_NAME=Doxa Staging
SUPPORT_EMAIL=<support email>

# --- App URLs ---
# Point at the staging web app / backend, not production.
FRONTEND_BASE_URL=http://localhost:3000
DOMAIN_NAME=localhost
BACKEND_API_URL=http://localhost:4000

# --- Feature flags ---
ENABLE_UNSEEN_MESSAGE_LISTENER=true

# --- Consultation sweep ---
# dry-run default is safe; set false ONLY against doxa-test.
# On the PROD project the sweep additionally requires
# CONSULTATION_SWEEP_CONFIRM_PROD=true or it refuses to run live.
CONSULTATION_SWEEP_DRY_RUN=true
# CONSULTATION_SWEEP_CONFIRM_PROD=true   # only for deliberate prod runs
